__pycache__/
*.pyc

# Raw dataset (478 MB, over GitHub's 100 MB file limit); download it from Kaggle instead.
# Anchored with a leading slash: a bare "data" matches EVERY directory named data, which
# silently excluded web/public/data/ (the site's own payload) as well.
/data/
.venv
outputs
scibert_embeddings.npy
# Large data / model outputs 
*.npy
*.npy.progress
/arXiv_full_data.csv
/enriched_arXiv_scientific_dataset_with_citations.csv
/enriched_arXiv_scientific_dataset_with_citations_full.csv
/enriched_arXiv_scientific_dataset.csv
/enriched_arXiv_scientific_full_dataset.csv
scibert_embeddings_full.npy

# Point-cloud prototype data (generated by export_points.py).
# NOT committed on the 3.2M-paper dataset: it is 1.2 GB even with abstracts stripped, over
# GitHub Pages' 1 GB published-site limit, so it has to be hosted outside the repo (see readme).
# The 287k dataset's export is 245 MB and CAN be committed -- comment this rule out if you
# switch back to it.
web/public/data/v2/

# Intermediate CSVs produced by add_influence.py (regenerate; don't commit)
*_with_influence.csv
influence_*.csv
